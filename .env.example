# Server-only settings. Never use VITE_OLLAMA_API_KEY.
OLLAMA_MODE=local-first
OLLAMA_LOCAL_HOST=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=qwen3:8b
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud
# Optional. Leave empty for local use; runtime only, never an image build arg.
OLLAMA_API_KEY=
OLLAMA_PROBE_TIMEOUT_MS=3000
OLLAMA_STREAM_TIMEOUT_MS=90000
# Local inference only: response wait / stream inactivity, not total duration.
OLLAMA_LOCAL_STREAM_TIMEOUT_MS=900000

# Local model only: default, true, false. Restart after changing.
OLLAMA_LOCAL_THINK=default
