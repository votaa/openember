{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openember.local/contracts/copilot/1.0",
  "$defs": {
    "interval": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "geography": {
          "type": [
            "string",
            "null"
          ]
        },
        "layer_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "geography",
        "layer_ids",
        "feature_ids",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "geography": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": "string"
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval": {
          "oneOf": [
            {
              "$ref": "#/$defs/interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "layer_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "geography",
        "timezone",
        "period",
        "interval",
        "layer_ids",
        "feature_ids",
        "source_ids",
        "fields"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "enum": [
            "browser_snapshot",
            "server_snapshot",
            "configured_kb"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "provenance"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "hidden",
            "omitted"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "omission_reason": {
          "enum": [
            null,
            "selection",
            "budget"
          ]
        }
      },
      "required": [
        "availability",
        "freshness",
        "completeness",
        "omission_reason"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "forecast",
            "map_layer",
            "reports_311",
            "kb",
            "document",
            "live",
            "catalog",
            "selected_feature"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_interval": {
          "oneOf": [
            {
              "$ref": "#/$defs/interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "geography": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "filter": {
              "type": [
                "string",
                "null"
              ]
            },
            "where": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "layer_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "filter",
            "where",
            "description",
            "layer_id"
          ],
          "additionalProperties": false
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "values": {
          "type": "object"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "fetched_at",
        "valid_interval",
        "geography",
        "scope",
        "state",
        "values",
        "limitations"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "forecast"
            },
            "values": {
              "type": "object",
              "properties": {
                "periods": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "maxItems": 1000
                }
              },
              "required": [
                "periods"
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "map_layer"
            },
            "values": {
              "type": "object",
              "properties": {
                "complete_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "samples": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "maxItems": 1000
                },
                "summary": {
                  "type": "object"
                }
              },
              "required": [
                "complete_count",
                "samples",
                "summary"
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "reports_311"
            },
            "values": {
              "type": "object",
              "properties": {
                "aggregate_counts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "total": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "total"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 1000
                },
                "report_window": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/interval"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "maxItems": 1000
                }
              },
              "required": [
                "aggregate_counts",
                "report_window",
                "records"
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "kb"
            },
            "values": {
              "type": "object",
              "properties": {
                "module_id": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "module_id",
                "content"
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "document"
            },
            "values": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "passages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "id",
                      "text",
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 1000
                }
              },
              "required": [
                "filename",
                "passages"
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "live"
            },
            "values": {
              "type": "object"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "values": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "content"
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "selected_feature"
            },
            "values": {
              "type": "object"
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "answer_method": {
          "enum": [
            "auto",
            "model"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 32000
              },
              "scope_key": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "role",
              "content"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "jurisdiction": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "enabled_kb_modules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 1000
            }
          },
          "required": [
            "id",
            "name",
            "timezone",
            "enabled_kb_modules"
          ],
          "additionalProperties": false
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 256
        },
        "requested_at": {
          "type": "string"
        },
        "context_version": {
          "const": "1.0"
        }
      },
      "required": [
        "contract_version",
        "request_id",
        "question",
        "answer_method",
        "history",
        "jurisdiction",
        "selection",
        "evidence",
        "requested_at"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "intent": {
          "enum": [
            "forecast_facts",
            "map_count",
            "reports_311",
            "synthesis"
          ]
        },
        "question": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "status": {
          "enum": [
            "ready",
            "acquire",
            "clarify",
            "unsupported",
            "synthesis"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "intent",
        "question",
        "scope",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "question": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "local",
            "synthesis",
            "clarification"
          ]
        },
        "reason": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          },
          "maxItems": 1000
        },
        "enabled_kb_modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "context_policy": {
          "enum": [
            "provider_specific"
          ]
        }
      },
      "required": [
        "contract_version",
        "question",
        "outcome",
        "reason",
        "operations",
        "enabled_kb_modules",
        "context_policy"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "local_query",
            "llm_grounded",
            "rule_based_fallback"
          ]
        },
        "answer_status": {
          "enum": [
            "answered",
            "clarification",
            "unsupported",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "intents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "answer": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "response_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          },
          "maxItems": 1000
        },
        "provider": {
          "enum": [
            null,
            "local",
            "cloud"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "enum": [
                  "local",
                  "cloud"
                ]
              },
              "code": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "code"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "requested_at": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "freshness": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "state": {
                "$ref": "#/$defs/state"
              }
            },
            "required": [
              "evidence_id",
              "state"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        },
        "timing": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "context": {
          "type": "object"
        }
      },
      "required": [
        "contract_version",
        "request_id",
        "execution_mode",
        "answer_status",
        "intents",
        "answer",
        "evidence_ids",
        "response_scope",
        "provider",
        "model",
        "attempts",
        "requested_at",
        "generated_at",
        "freshness",
        "warnings",
        "timing"
      ],
      "additionalProperties": false
    }
  }
}
